{
  "name": "jsgui3-ecosystem",
  "version": "0.0.0",
  "private": true,
  "description": "Coordination docs and cross-repo example tooling for the jsgui3 ecosystem.",
  "scripts": {
    "examples:list": "node scripts/example_smoke.js --list",
    "examples:scan": "node scripts/example_smoke.js --scan",
    "examples:scan:summary": "node scripts/example_smoke.js --scan --summary",
    "smoke:examples": "node scripts/example_smoke.js --smoke",
    "smoke:examples:summary": "node scripts/example_smoke.js --smoke --summary",
    "smoke:examples:startup": "node scripts/example_smoke.js --smoke --run-startup",
    "docs:check": "node scripts/example_smoke.js --check-docs",
    "docs:viewer:check": "node scripts/example_smoke.js --check-docs-viewer",
    "test": "node --test tests/*.test.js"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
